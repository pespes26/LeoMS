#!/usr/bin/env bash
set -Eeuo pipefail

state_dir=/var/lib/leoms-backup
heartbeat="$state_dir/worker-alive"

read_secret() {
  local path="$1"
  local value
  value="$(tr -d '\r\n' < "$path")"
  [[ -n "$value" ]] || { echo "Empty secret: $path" >&2; return 1; }
  printf '%s' "$value"
}

configure_secrets() {
  export MYSQL_PWD
  MYSQL_PWD="$(read_secret "${MYSQL_PASSWORD_FILE:?missing MYSQL_PASSWORD_FILE}")"
  export RESTIC_PASSWORD_FILE
  RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:?missing RESTIC_PASSWORD_FILE}"
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
  AWS_ACCESS_KEY_ID="$(read_secret "${AWS_ACCESS_KEY_ID_FILE:?missing AWS_ACCESS_KEY_ID_FILE}")"
  AWS_SECRET_ACCESS_KEY="$(read_secret "${AWS_SECRET_ACCESS_KEY_FILE:?missing AWS_SECRET_ACCESS_KEY_FILE}")"
}

mysql_cmd() {
  mysql --batch --skip-column-names -h "${MYSQL_HOST}" -u "${MYSQL_USER}" "${MYSQL_DATABASE}" "$@"
}

wait_for_database() {
  local tries=0
  until mysqladmin ping -h "${MYSQL_HOST}" -u "${MYSQL_USER}" --silent; do
    tries=$((tries + 1))
    if (( tries >= 60 )); then
      echo 'Database did not become available.' >&2
      return 1
    fi
    sleep 5
  done
}

ensure_repository() {
  if ! restic snapshots >/dev/null 2>&1; then
    echo 'Initializing restic repository.'
    restic init
  fi
}

create_job() {
  local actor="$1"
  mysql_cmd -e "INSERT INTO leoms_backup_jobs (requested_by, state) VALUES ('${actor}', 'RUNNING'); SELECT LAST_INSERT_ID();"
}

claim_manual_job() {
  local id
  id="$(mysql_cmd -e "SELECT id FROM leoms_backup_jobs WHERE state='REQUESTED' ORDER BY requested_at LIMIT 1;")"
  [[ -n "$id" ]] || return 1
  mysql_cmd -e "UPDATE leoms_backup_jobs SET state='RUNNING', started_at=CURRENT_TIMESTAMP(6) WHERE id=${id} AND state='REQUESTED';"
  printf '%s' "$id"
}

finish_job() {
  local id="$1" state="$2" snapshot="${3:-}" message="${4:-}"
  # Messages are generated by this worker, not user input; still strip quotes and cap length.
  message="${message//\'/}"
  message="${message:0:240}"
  mysql_cmd -e "UPDATE leoms_backup_jobs SET state='${state}', finished_at=CURRENT_TIMESTAMP(6), snapshot_id=NULLIF('${snapshot}',''), message=NULLIF('${message}','') WHERE id=${id};"
}

perform_backup() {
  local job_id="$1"
  local stamp dump output snapshot
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  dump="$state_dir/leoms-${stamp}.sql.gz"

  if ! mysqldump --host="${MYSQL_HOST}" --user="${MYSQL_USER}" \
      --single-transaction --quick --routines --events --triggers --no-tablespaces \
      --set-gtid-purged=OFF "${MYSQL_DATABASE}" | gzip -9 > "$dump"; then
    finish_job "$job_id" FAILED '' 'mysqldump failed'
    return 1
  fi

  if ! output="$(restic backup --json --tag leoms --tag six-hour "$dump" 2>&1)"; then
    finish_job "$job_id" FAILED '' 'restic upload failed'
    return 1
  fi
  snapshot="$(printf '%s\n' "$output" | jq -r 'select(.message_type == "summary") | .snapshot_id' | tail -1)"
  restic forget --tag leoms --keep-within 7d --keep-daily 30 --keep-weekly 8 --prune
  find "$state_dir" -maxdepth 1 -type f -name 'leoms-*.sql.gz' -mtime +7 -delete
  finish_job "$job_id" SUCCEEDED "$snapshot" 'encrypted snapshot uploaded'
}

run_worker() {
  configure_secrets
  wait_for_database
  ensure_repository
  local interval="${BACKUP_INTERVAL_SECONDS:-21600}"
  local last_scheduled=0 now job_id
  while true; do
    touch "$heartbeat"
    now="$(date +%s)"
    if job_id="$(claim_manual_job)"; then
      perform_backup "$job_id" || true
    elif (( now - last_scheduled >= interval )); then
      job_id="$(create_job scheduler)"
      mysql_cmd -e "UPDATE leoms_backup_jobs SET started_at=CURRENT_TIMESTAMP(6) WHERE id=${job_id};"
      perform_backup "$job_id" || true
      last_scheduled="$now"
    fi
    sleep 30
  done
}

case "${1:-run}" in
  run) run_worker ;;
  healthcheck) [[ -f "$heartbeat" ]] && find "$heartbeat" -mmin -2 -print -quit | grep -q . ;;
  backup-now)
    configure_secrets; wait_for_database; ensure_repository
    job_id="$(create_job cli)"; perform_backup "$job_id"
    ;;
  restore-latest)
    configure_secrets; ensure_repository
    mkdir -p "$state_dir/restore"
    find "$state_dir/restore" -mindepth 1 -delete
    restic restore "${RESTIC_SNAPSHOT:-latest}" --tag leoms --target "$state_dir/restore"
    ;;
  *) echo "Usage: backup-worker [run|healthcheck|backup-now|restore-latest]" >&2; exit 64 ;;
esac
